---
export const prerender = false;

import BaseLayout from '@layouts/BaseLayout.astro';
import { getAuditClient } from '@data/audit-clients';
import { hashPasscode, AUDIT_COOKIE_MAX_AGE } from '@utils/auditAuth';

const { client: slug } = Astro.params;
const client = slug ? getAuditClient(slug) : undefined;

if (!client) {
  return Astro.redirect('/404');
}

const url = new URL(Astro.request.url);
const rawNext = url.searchParams.get('next') || `/audits/${slug}/`;
// Only ever redirect back inside this client's own audit tree — never off-site.
const next = rawNext.startsWith(`/audits/${slug}/`) ? rawNext : `/audits/${slug}/`;
const unconfigured = url.searchParams.has('unconfigured');

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const passcode = String(form.get('passcode') || '');
  // process.env, not import.meta.env — see the matching comment in src/middleware.ts.
  const expectedPasscode = process.env[client.envVar];

  if (expectedPasscode && passcode) {
    const submittedHash = await hashPasscode(slug!, passcode);
    const expectedHash = await hashPasscode(slug!, expectedPasscode);

    if (submittedHash === expectedHash) {
      Astro.cookies.set(`audit_${slug}`, submittedHash, {
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        path: `/audits/${slug}`,
        maxAge: AUDIT_COOKIE_MAX_AGE,
      });
      return Astro.redirect(next);
    }
  }

  error = expectedPasscode ? 'That passcode is incorrect.' : 'This audit isn’t configured yet.';
}
---

<BaseLayout title={`${client.name} — Private Assessment`} noindex={true}>
  <div class="max-w-sm mx-auto py-16">
    <p class="font-mono text-xs tracking-wider uppercase text-accent-600 mb-3 text-center">Private Assessment</p>
    <h1 class="text-2xl text-center mb-2">{client.name}</h1>
    <p class="text-sm text-neutral-600 text-center mb-8">
      Enter the passcode you were given to view this assessment.
    </p>

    <form method="POST" class="card p-6 space-y-4">
      <div>
        <label for="passcode" class="block text-sm font-medium text-neutral-700 mb-1">Passcode</label>
        <input
          type="password"
          id="passcode"
          name="passcode"
          autofocus
          required
          class="w-full px-4 py-2 border border-neutral-300 rounded-md focus:ring-2 focus:ring-primary-500 focus:border-transparent"
          placeholder="••••••••"
        />
      </div>

      {(error || unconfigured) && (
        <p class="text-sm text-red-600">
          {unconfigured ? 'This assessment isn’t set up yet — check back soon.' : error}
        </p>
      )}

      <button type="submit" class="btn btn-primary w-full">Continue</button>
    </form>
  </div>
</BaseLayout>
