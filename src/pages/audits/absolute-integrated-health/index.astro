---
export const prerender = false;

import BaseLayout from '@layouts/BaseLayout.astro';
import AuditNav from '@components/audit/AuditNav.astro';

const base = '/audits/absolute-integrated-health/';

const stats = [
  { n: '0', l: "working booking options behind the homepage's main button — it leads to a dead event page instead" },
  { n: '3', l: 'different "book now" buttons on your site, none of them agreeing on how a patient actually books' },
  { n: '235', l: 'five-star reviews you\'ve earned — almost none of them visible anywhere on the site itself' },
  { n: '0 of 2', l: "core local searches where you appear in Google's map pack" },
  { n: '4', l: 'public identities for one growing business, none connected to each other' },
  { n: '5→0', l: 'competitors ChatGPT names for chronic pain care near you — you’re not one of them' },
  { n: '50/100', l: 'mobile speed score — desktop scores 92/100 on the identical page' },
];

const findings = [
  {
    title: 'Three different "book now" buttons — only one of them actually works',
    body: 'The homepage hero, a mid-page banner, and the footer each promise a way to book, and each leads somewhere different: a dead event page, a working lead form, and a completely different-looking third-party booking site that only covers three of your services. There\'s no single answer to "how does a new patient actually book here" — which means some real share of ready-to-book visitors quietly give up mid-click.',
  },
  {
    title: 'A live page is selling the wrong service to patients in pain',
    body: 'The Chronic Pain page — for someone actively researching relief right now — has Wound Care copy mistakenly pasted into its main trust section. A five-minute fix, but it\'s live today, at exactly the page whose job is convincing a hesitant visitor this practice pays close attention.',
  },
  {
    title: '235 five-star reviews and 15 credentialed providers are nearly invisible on your own site',
    body: 'That reputation took years and real money to earn, and it\'s barely used: homepage testimonials rotate through 3 unrated quotes with no photos, and your provider roster — RNs, FNPs, DCs — shows a name and a headshot, nothing about who treats what. Trust is the entire currency of a medical decision, and the assets to build it are sitting unused.',
  },
  {
    title: "You're nearly invisible in local search and AI answers",
    body: "Zero presence in Google's map pack for your core searches, and AI tools like ChatGPT and Perplexity name competitors with lower ratings ahead of you — or skip you entirely. Not a reputation problem, 4.8 stars is strong; a technical visibility problem, and every day it goes unfixed is demand routed to someone else.",
  },
  {
    title: 'Aesthetics is only findable if you already know to look for it',
    body: `Botox, fillers, Sculptra, microneedling, vein care — real services you fully offer, with a real menu for them under the header dropdown. But the Services page's own filter buttons ("Integrative Health," "Pain Relief," "Physical Therapy") and its footer service list both leave aesthetics out entirely. A visitor who lands on the Services page and filters, or who scans the footer, never sees it — only someone who happens to hover the top nav does. Real revenue, one inconsistent click away from invisible.`,
  },
  {
    title: 'Four public identities for one growing business, none connected to each other',
    body: `A dormant second website still live under your name, a separate Google listing for "AIH Aesthetics & Wellness," a live ad campaign right now for a brand-new "Vita Med Naperville" location with no visible connection back to you, and two different phone numbers appearing across your own ads. Anyone doing due diligence — a patient, a landlord, a future partner — sees a business that looks fragmented, not one that's growing on purpose.`,
  },
  {
    title: "The site isn't built to become a multi-location site",
    body: "Address, phone, and hours are hardcoded into one homepage, with no template to copy when the next location opens. Right now there's one set of inconsistencies to clean up. At three or seven locations, the same problems get copied and multiplied instead of solved once.",
  },
  {
    title: 'On mobile — where nearly all your ad traffic lands — the site fails outright',
    body: '15 seconds to load real content, against a 2.5-second bar Google considers acceptable. Roughly half of visitors abandon a page this slow before they ever see your offer, and mobile speed is itself a ranking factor — quietly suppressing the local search problem above it too.',
  },
];
---

<BaseLayout
  title="Absolute Integrated Health — Executive Brief"
  description="A two-minute summary of what's working, what's costing Absolute Integrated Health leads, and the recommended next step ahead of their multi-location expansion."
  noindex={true}
>
  <AuditNav current="brief" base={base} />

  <header class="mb-10 animate-in">
    <p class="font-mono text-xs tracking-wider uppercase text-accent-600 mb-3">
      Executive Brief · 1 of 4
    </p>
    <h1 class="mb-3">Absolute Integrated Health</h1>
    <p class="text-lg text-neutral-600 max-w-2xl">
      Two minutes on what's working, what's costing you leads, and what to do about it — before further expansion.
    </p>
  </header>

  <section class="mb-12 animate-in delay-1">
    <p class="text-xl leading-relaxed text-neutral-800 max-w-2xl">
      You've already built the hard part — a real service line, active ads, a working CRM, and a 4.8-star
      reputation built over hundreds of real reviews. What's underneath hasn't caught up, and it's costing you
      patients you've already paid to reach: <strong class="text-accent-700">booking paths that don't agree with
      each other, a revenue line that only shows up if a visitor happens to look in the right place, trust you've
      earned but aren't showing, and four public identities for one growing business that don't connect to each
      other.</strong> None
      of it requires starting over. All of it gets more expensive to fix with every location you add.
    </p>
  </section>

  <section class="mb-12 animate-in delay-2">
    <p class="font-mono text-xs tracking-wider uppercase text-primary-600 mb-4">The Numbers</p>
    <h2 class="mb-5">Tested live, not estimated</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {stats.map((s) => (
        <div class="card p-5">
          <div class="font-mono text-2xl font-semibold text-accent-600 tabular-nums">{s.n}</div>
          <div class="mt-2 text-sm text-neutral-600 leading-snug">{s.l}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-12 animate-in delay-3">
    <p class="font-mono text-xs tracking-wider uppercase text-primary-600 mb-4">What's Costing You</p>
    <h2 class="mb-5">Eight things worth fixing, ranked by impact on new patients and revenue</h2>
    <div class="divide-y divide-neutral-200 border-t border-b border-neutral-200">
      {findings.map((f, i) => (
        <div class="grid grid-cols-[2rem_1fr] gap-3 py-4">
          <div class="font-mono text-sm text-neutral-400 pt-0.5">{String(i + 1).padStart(2, '0')}</div>
          <div>
            <h3 class="text-base font-semibold text-neutral-900 mb-1">{f.title}</h3>
            <p class="text-sm text-neutral-600 mb-0">{f.body}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-6 rounded-lg border-l-4 border-green-500 bg-green-50 px-5 py-4 text-sm text-green-800">
      Every item above is fixable, most of it quickly, and none of it means starting over. The 235 reviews and 4.8
      rating prove the reputation problem doesn't exist — this is a visibility, consistency, and process problem,
      which is the cheap kind to solve, and the kind that compounds fastest if it waits until after the next
      location opens.
    </div>
    <p class="text-sm text-neutral-500 mt-4">
      The first item is walked through step by step, with screenshots of exactly where visitors get stuck, in the
      <a href={`${base}ux`}>UX &amp; Conversion Design</a> assessment.
    </p>
  </section>

  <section class="mb-4 animate-in delay-4">
    <div class="rounded-lg border border-primary-900 bg-primary-900 text-white p-8 sm:p-10">
      <p class="font-mono text-xs tracking-wider uppercase text-primary-200 mb-3">Recommended Next Step</p>
      <h2 class="text-white mb-3">Start with the website — built location-ready from day one</h2>
      <p class="text-primary-100 mb-6 max-w-xl">
        Fix the trust and consistency issues first, on a foundation that's ready to become the next location's site with a
        copy-and-edit, not a redo. The full assessment walks through the complete findings, the evidence behind each
        one, and a phased path from here through the next several locations.
      </p>
      <a href={`${base}full`} class="btn bg-accent-500 text-white hover:bg-accent-600">
        Read the Full Assessment →
      </a>
    </div>
  </section>

  <p class="font-mono text-xs text-neutral-400 mt-10">
    Absolute Integrated Health — Digital Presence &amp; Growth Readiness Assessment · Prepared August 13, 2026
  </p>
</BaseLayout>
