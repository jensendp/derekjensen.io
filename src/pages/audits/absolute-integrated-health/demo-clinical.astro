---
export const prerender = false;

const services = [
  {
    name: 'Chiropractic Care',
    line: 'Hands-on adjustment and mobility work, backed by a plan tailored to your body.',
  },
  {
    name: 'Pain Management',
    line: 'A clinical approach to pain that hasn’t responded to medication alone.',
  },
  {
    name: 'IV & Hormone Therapy',
    line: 'Physician-guided IV and hormone support, administered on-site by our team.',
  },
  {
    name: 'Wound Care',
    line: 'Specialized wound treatment for cases that need more than a standard visit.',
  },
  {
    name: 'Aesthetics & Wellness',
    line: 'Medical-grade aesthetic treatments, delivered by a clinical team you already trust.',
  },
];

const team = [
  { name: 'Dr. James Nakis', role: 'Chiropractor', photo: '/audits/absolute-integrated-health/staff-jim.jpg' },
  { name: 'Alyssa Fleischauer', role: 'RN', photo: '/audits/absolute-integrated-health/staff-alyssa.jpg' },
  { name: 'Cynthia Clark-Zurawski', role: 'FNP, APRN', photo: '/audits/absolute-integrated-health/staff-cynthia.webp' },
  { name: 'Andrew Nakis', role: 'Care Team', photo: '/audits/absolute-integrated-health/staff-andrew.jpg' },
  { name: 'Monica Galik', role: 'Care Team', photo: '/audits/absolute-integrated-health/staff-monica.webp' },
  { name: 'Jay Zurawski', role: 'RN', photo: '/audits/absolute-integrated-health/staff-jay.jpg' },
];

const intakeOptions = [
  'Chronic or ongoing pain',
  'IV or hormone therapy',
  'Aesthetics & wellness',
  'Wound care',
  'Not sure yet — I’d like to talk it through',
];

const processSteps = [
  {
    title: 'Consultation',
    body: 'Tell us what’s going on and what you’re hoping to fix — no assumptions, just a real conversation.',
  },
  {
    title: 'Assessment',
    body: 'Our team examines you in person and builds a plan around your body, not a generic protocol.',
  },
  {
    title: 'Personalized Plan',
    body: 'Start treatment the same day when appropriate, with follow-ups scheduled around your life.',
  },
];

const faqs = [
  {
    q: 'Do you accept insurance?',
    a: 'We work with most major insurance plans, and offer 0% APR financing for services that aren’t covered.',
  },
  {
    q: 'What should I bring to my first visit?',
    a: 'Just a photo ID and your insurance card, if you have one — we’ll handle the rest during your consultation.',
  },
  {
    q: 'Do I need a referral?',
    a: 'No referral is required for a chiropractic or wellness consultation.',
  },
  {
    q: 'Can I walk in, or do I need an appointment?',
    a: 'We recommend requesting a consultation ahead of time so we can prepare for your visit — call 815-782-8440 for same-day availability.',
  },
];

const testimonials = [
  {
    quote: 'Friendly greeting, caring staff, to professional workforce. Your experience and well being is paramount in here. You’ll be leaving with a healed body and a smile on your face. I will recommend to family and friends.',
    name: 'Arnulfo Q.',
  },
  {
    quote: 'Not just another chiropractor. They treat the whole body. Trusted innovative procedures. Friendly helpful staff. Give ’em a try. I’ve been seeing them for 20+ years.',
    name: 'Tim V.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Absolute Integrated Health — Concept Preview (Clinical)</title>
    <meta name="description" content="A second concept preview of a rebuilt Absolute Integrated Health homepage, closer to the current brand identity, prepared by Derek Jensen." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="concept-ribbon">
      <span>Concept preview (clinical direction) for Absolute Integrated Health — built by Derek Jensen, not a live site</span>
      <span class="ribbon-links">
        <a href="/audits/absolute-integrated-health/demo">View the warm concept →</a>
        <a href="/audits/absolute-integrated-health/">← Back to the assessment</a>
      </span>
    </div>

    <header class="site-header">
      <a href="#top" class="wordmark">
        <img src="/audits/absolute-integrated-health/logo-icon.png" alt="" class="wordmark-icon" />
        <span class="wordmark-mark">Absolute Integrated Health</span>
      </a>
      <nav class="main-nav" aria-label="Primary">
        <a href="#services">Services</a>
        <a href="#team">Our Team</a>
        <a href="#request-consultation" class="nav-cta">Schedule Now</a>
      </nav>
      <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Plainfield, IL &middot; Chiropractic &amp; Integrative Health</p>
          <h1>Comprehensive, coordinated care — under one roof, one team.</h1>
          <p class="hero-sub">
            Chiropractic, pain management, IV therapy, wound care, and aesthetics — a
            clinical team that starts every relationship with a real consultation, not a
            generic booking form.
          </p>
          <div class="hero-actions">
            <a href="#request-consultation" class="btn btn-primary">Request a Consultation</a>
            <a href="tel:8157828440" class="btn btn-ghost">815-782-8440</a>
          </div>
          <p class="hero-trust">&#9733;&#9733;&#9733;&#9733;&#9733; 4.8 from 235 Google reviews</p>
          <p class="hours-badge" id="hours-badge"></p>
        </div>
        <div class="hero-art">
          <div class="hero-photo-frame">
            <img src="/audits/absolute-integrated-health/hero-relief-couple.jpg" alt="An older couple happily preparing a healthy meal together" />
          </div>
          <div class="hero-card">
            <p class="hero-card-stat">5</p>
            <p class="hero-card-label">care specialties, one intake conversation</p>
          </div>
        </div>
      </section>

      <section class="trust-strip">
        <div class="trust-item">
          <p class="trust-num">4.8&#9733;</p>
          <p>235 Google reviews</p>
        </div>
        <div class="trust-item">
          <p class="trust-num">5</p>
          <p>specialties, one coordinated care team</p>
        </div>
        <div class="trust-item">
          <p class="trust-num">0%</p>
          <p>APR financing available — no hard credit check</p>
        </div>
      </section>

      <section id="services" class="services">
        <p class="section-eyebrow">What we treat</p>
        <h2>One practice, five ways to feel better</h2>
        <div class="services-grid">
          {services.map((s) => (
            <div class="service-card">
              <div class="service-mark" aria-hidden="true"></div>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="team" class="team">
        <p class="section-eyebrow">Who you'll meet</p>
        <h2>A clinical team, not a call center</h2>
        <p class="team-sub">The people who'll actually be in the room with you.</p>
        <div class="team-grid">
          {team.map((t) => (
            <div class="team-card">
              <img src={t.photo} alt={t.name} />
              <p class="team-name">{t.name}</p>
              <p class="team-role">{t.role}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="testimonials">
        <p class="section-eyebrow">Patient reviews</p>
        <h2>235 Google reviews, 4.8 stars average</h2>
        <div class="testimonial-grid">
          {testimonials.map((t) => (
            <blockquote class="testimonial-card">
              <p class="testimonial-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
              <p class="testimonial-quote">{t.quote}</p>
              <cite>{t.name} &mdash; Google review</cite>
            </blockquote>
          ))}
        </div>
      </section>

      <section class="process">
        <p class="section-eyebrow">How it starts</p>
        <h2>What to expect at your first visit</h2>
        <div class="process-grid">
          {processSteps.map((s, i) => (
            <div class="process-step">
              <div class="process-num">{i + 1}</div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="faq">
        <p class="section-eyebrow">Before you book</p>
        <h2>Common questions</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}<span class="faq-icon" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section id="request-consultation" class="consult">
        <div class="consult-copy">
          <p class="section-eyebrow section-eyebrow-light">Get started</p>
          <h2>Request a consultation</h2>
          <p>
            One form, one path — no separate booking systems to choose between. Tell us
            what brings you in, and our team will reach out to get you on the schedule.
          </p>
          <p class="consult-note">No appointment changes here — for rescheduling, just give us a call at 815-782-8440.</p>
        </div>
        <form class="consult-form" onsubmit="event.preventDefault();">
          <label>
            Name
            <input type="text" name="name" placeholder="Your full name" />
          </label>
          <label>
            Phone
            <input type="tel" name="phone" placeholder="(815) 000-0000" />
          </label>
          <label>
            What brings you in today?
            <select name="reason">
              {intakeOptions.map((opt) => <option>{opt}</option>)}
            </select>
          </label>
          <button type="submit" class="btn btn-primary btn-block">Send My Request</button>
          <p class="form-note">Concept preview — this form isn't connected yet.</p>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <div>
        <p class="footer-wordmark">Absolute Integrated Health</p>
        <p>16310 S Lincoln Hwy #124, Plainfield, IL 60586</p>
        <p>815-782-8440</p>
      </div>
      <p class="footer-credit">
        Design concept by <a href="https://derekjensen.io">Derek Jensen</a> — built to show what's
        possible, not the final site.
      </p>
    </footer>

    <div class="sticky-cta">
      <a href="#request-consultation" class="btn btn-primary btn-block">Request a Consultation</a>
    </div>

    <style>
      :root {
        --bg: #f4f8fb;
        --bg-alt: #eaf1f7;
        --card: #ffffff;
        --ink: #1c2b38;
        --ink-soft: #56697a;
        --blue-deep: #123b5e;
        --blue: #1f6fa8;
        --blue-pale: #dceafa;
        --green: #6fa82e;
        --green-deep: #578421;
        --line: rgba(18, 59, 94, 0.14);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: 'IBM Plex Sans', system-ui, sans-serif;
        line-height: 1.6;
      }

      h1, h2, h3, .wordmark-mark {
        font-family: 'Sora', system-ui, sans-serif;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--blue-deep);
      }

      .concept-ribbon {
        background: var(--blue-deep);
        color: #eaf1f7;
        font-size: 0.78rem;
        padding: 0.55rem 1.25rem;
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
        justify-content: center;
        text-align: center;
      }
      .ribbon-links { display: flex; gap: 1.25rem; }
      .concept-ribbon a { color: #eaf1f7; opacity: 0.85; }
      .concept-ribbon a:hover { opacity: 1; }

      .site-header {
        position: relative;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem clamp(1.25rem, 5vw, 4rem);
        max-width: 1280px;
        margin: 0 auto;
      }

      .nav-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        border: none;
        background: transparent;
        cursor: pointer;
      }
      .nav-toggle span {
        display: block;
        width: 100%;
        height: 2px;
        border-radius: 2px;
        background: var(--blue-deep);
        transition: transform 0.2s ease, opacity 0.2s ease;
      }
      .nav-toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .nav-toggle.is-open span:nth-child(2) { opacity: 0; }
      .nav-toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

      .wordmark { text-decoration: none; display: flex; align-items: center; gap: 0.6rem; }
      .wordmark-icon { height: 2.1rem; width: auto; display: block; }
      .wordmark-mark { font-size: 1.15rem; }

      .main-nav { display: flex; align-items: center; gap: 1.75rem; font-size: 0.92rem; }
      .main-nav a { color: var(--ink); text-decoration: none; font-weight: 500; }
      .main-nav a:hover { color: var(--blue); }
      .nav-cta {
        background: var(--green);
        color: #fff !important;
        padding: 0.6rem 1.2rem;
        border-radius: 0.4rem;
        font-weight: 700;
      }
      .nav-cta:hover { background: var(--green-deep) !important; }

      main { max-width: 1280px; margin: 0 auto; padding: 0 clamp(1.25rem, 5vw, 4rem); }

      .hero {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: clamp(2rem, 5vw, 4.5rem);
        align-items: center;
        padding: clamp(2rem, 6vw, 4.5rem) 0 clamp(3rem, 6vw, 5rem);
      }

      .eyebrow, .section-eyebrow {
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--blue);
        font-weight: 700;
        margin: 0 0 0.9rem;
      }
      .section-eyebrow-light { color: #a9c9e0; }

      .hero h1 {
        font-size: clamp(2.1rem, 3.8vw, 3.1rem);
        line-height: 1.15;
        margin: 0 0 1.2rem;
      }

      .hero-sub {
        color: var(--ink-soft);
        font-size: 1.05rem;
        max-width: 34rem;
        margin: 0 0 1.9rem;
      }

      .hero-actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-bottom: 1.5rem; }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.85rem 1.6rem;
        border-radius: 0.5rem;
        font-weight: 700;
        text-decoration: none;
        font-size: 0.95rem;
        transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
      }
      .btn-primary { background: var(--green); color: #fff; }
      .btn-primary:hover { background: var(--green-deep); }
      .btn-ghost { border: 1.5px solid var(--line); color: var(--blue-deep); }
      .btn-ghost:hover { border-color: var(--blue); color: var(--blue); }
      .btn-block { width: 100%; }

      .hero-trust { font-size: 0.9rem; color: var(--ink-soft); margin: 0; font-weight: 500; }
      .hours-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.85rem;
        color: var(--ink-soft);
        font-weight: 500;
        margin: 0.6rem 0 0;
      }
      .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; display: inline-block; }
      .dot-open { background: var(--green); }
      .dot-closed { background: var(--blue); opacity: 0.6; }

      .hero-art { position: relative; }
      .hero-photo-frame {
        border-radius: 0.9rem;
        overflow: hidden;
        aspect-ratio: 4 / 3.6;
        box-shadow: 0 20px 45px -20px rgba(18, 59, 94, 0.4);
        border: 6px solid var(--card);
        outline: 1px solid var(--line);
      }
      .hero-photo-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .hero-card {
        position: absolute;
        left: -6%;
        bottom: -8%;
        background: var(--blue-deep);
        color: #fff;
        border-radius: 0.75rem;
        padding: 1.1rem 1.4rem;
        box-shadow: 0 20px 40px -18px rgba(18, 59, 94, 0.5);
        max-width: 12rem;
      }
      .hero-card-stat { font-family: 'Sora', sans-serif; font-size: 2rem; margin: 0; color: #9fd15a; }
      .hero-card-label { margin: 0.15rem 0 0; font-size: 0.82rem; color: #cfe1f0; }

      .trust-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 0.75rem;
        padding: 2rem clamp(1.25rem, 4vw, 3rem);
        margin-bottom: clamp(3rem, 6vw, 5rem);
      }
      .trust-item p { margin: 0; }
      .trust-num { font-family: 'Sora', sans-serif; font-size: 1.8rem; color: var(--blue); margin-bottom: 0.2rem !important; }
      .trust-item p:last-child { color: var(--ink-soft); font-size: 0.9rem; }

      .services, .team { margin-bottom: clamp(3rem, 6vw, 5rem); }
      .services h2, .team h2, .consult h2 { font-size: clamp(1.7rem, 2.8vw, 2.2rem); margin: 0 0 0.6rem; }
      .team-sub { color: var(--ink-soft); margin: 0 0 2.2rem; }

      .services-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.25rem;
        margin-top: 2rem;
      }
      .service-card {
        flex: 1 1 200px;
        background: var(--card);
        border: 1px solid var(--line);
        border-top: 3px solid var(--blue);
        border-radius: 0.6rem;
        padding: 1.6rem;
      }
      .service-mark {
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        background: var(--green);
        margin-bottom: 0.9rem;
      }
      .service-card h3 { font-size: 1.08rem; margin: 0 0 0.5rem; }
      .service-card p { margin: 0; color: var(--ink-soft); font-size: 0.92rem; }

      .team-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.75rem;
      }
      .team-card { flex: 1 1 160px; text-align: center; }
      .team-card img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 0.6rem;
        margin-bottom: 0.9rem;
        border: 4px solid var(--card);
        outline: 1px solid var(--line);
        box-shadow: 0 10px 20px -12px rgba(18, 59, 94, 0.35);
      }
      .team-name { font-weight: 700; margin: 0; color: var(--blue-deep); }
      .team-role { color: var(--green-deep); font-size: 0.85rem; margin: 0.1rem 0 0; font-weight: 600; }

      .testimonials { margin-bottom: clamp(3rem, 6vw, 5rem); }
      .testimonial-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }
      .testimonial-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-left: 3px solid var(--green);
        border-radius: 0.6rem;
        padding: 1.75rem;
        margin: 0;
      }
      .testimonial-stars {
        color: var(--green);
        letter-spacing: 0.1em;
        margin: 0 0 0.9rem;
        font-size: 0.95rem;
      }
      .testimonial-quote {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink);
        margin: 0 0 1.1rem;
      }
      .testimonial-card cite {
        font-style: normal;
        font-size: 0.85rem;
        color: var(--blue-deep);
        font-weight: 700;
      }

      .process { margin-bottom: clamp(3rem, 6vw, 5rem); }
      .process-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2.25rem;
        margin-top: 2.25rem;
      }
      .process-step {
        flex: 0 1 240px;
        text-align: left;
        border-left: 3px solid var(--blue);
        padding-left: 1.1rem;
      }
      .process-num {
        width: 2.25rem;
        height: 2.25rem;
        margin-bottom: 0.9rem;
        border-radius: 0.4rem;
        background: var(--blue-deep);
        color: #fff;
        font-family: 'Sora', sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .process-step h3 { font-size: 1.05rem; margin: 0 0 0.5rem; color: var(--blue-deep); }
      .process-step p { margin: 0; color: var(--ink-soft); font-size: 0.92rem; }

      .faq { margin-bottom: clamp(3rem, 6vw, 5rem); }
      .faq-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        column-gap: 3rem;
        margin-top: 2rem;
      }
      .faq-item {
        border-bottom: 1px solid var(--line);
        padding: 1.1rem 0;
      }
      .faq-item summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        font-weight: 700;
        color: var(--blue-deep);
        list-style: none;
      }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-icon {
        position: relative;
        width: 1rem;
        height: 1rem;
        flex-shrink: 0;
        margin-left: 1rem;
      }
      .faq-icon::before, .faq-icon::after {
        content: '';
        position: absolute;
        background: var(--green);
        transition: transform 0.2s ease;
      }
      .faq-icon::before { top: 50%; left: 0; width: 100%; height: 2px; transform: translateY(-50%); }
      .faq-icon::after { left: 50%; top: 0; width: 2px; height: 100%; transform: translateX(-50%); }
      .faq-item[open] .faq-icon::after { transform: translateX(-50%) scaleY(0); }
      .faq-item p { margin: 0.9rem 0 0; color: var(--ink-soft); font-size: 0.95rem; }

      .sticky-cta {
        display: none;
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 90;
        padding: 0.85rem 1.1rem calc(0.85rem + env(safe-area-inset-bottom, 0px));
        background: var(--card);
        border-top: 1px solid var(--line);
        box-shadow: 0 -12px 24px -18px rgba(18, 59, 94, 0.4);
      }

      .consult {
        background: var(--blue-deep);
        color: #eaf1f7;
        border-radius: 0.9rem;
        padding: clamp(2rem, 5vw, 3.5rem);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(2rem, 4vw, 3.5rem);
        align-items: start;
        margin-bottom: clamp(3rem, 6vw, 5rem);
      }
      .consult h2 { color: #fff; }
      .consult-copy p { color: #c3d8e8; max-width: 28rem; }
      .consult-note { font-size: 0.85rem; opacity: 0.9; }

      .consult-form { display: flex; flex-direction: column; gap: 1rem; }
      .consult-form label {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: #dce9f2;
        font-weight: 500;
      }
      .consult-form input, .consult-form select {
        font-family: inherit;
        font-size: 0.95rem;
        padding: 0.75rem 0.9rem;
        border-radius: 0.4rem;
        border: 1px solid rgba(255, 255, 255, 0.25);
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
      }
      .consult-form select option { color: var(--ink); }
      .form-note { font-size: 0.78rem; opacity: 0.75; margin: 0; text-align: center; }

      .site-footer {
        max-width: 1280px;
        margin: 0 auto;
        padding: 2.5rem clamp(1.25rem, 5vw, 4rem) 3.5rem;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1.5rem;
        border-top: 1px solid var(--line);
        font-size: 0.88rem;
        color: var(--ink-soft);
      }
      .footer-wordmark { font-size: 1.05rem; color: var(--blue-deep); font-weight: 700; margin: 0 0 0.3rem; font-family: 'Sora', sans-serif; }
      .site-footer p { margin: 0.1rem 0; }
      .footer-credit a { color: var(--blue); }

      @media (prefers-reduced-motion: no-preference) {
        .reveal {
          opacity: 0;
          transform: translateY(18px);
          transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.3, 1), transform 0.7s cubic-bezier(0.2, 0.7, 0.3, 1);
        }
        .reveal.is-visible { opacity: 1; transform: none; }

        .reveal-group > * {
          opacity: 0;
          transform: translateY(14px);
          transition: opacity 0.6s ease, transform 0.6s ease;
        }
        .reveal-group.is-visible > * { opacity: 1; transform: none; }
        .reveal-group.is-visible > *:nth-child(2) { transition-delay: 90ms; }
        .reveal-group.is-visible > *:nth-child(3) { transition-delay: 180ms; }
        .reveal-group.is-visible > *:nth-child(4) { transition-delay: 270ms; }
        .reveal-group.is-visible > *:nth-child(5) { transition-delay: 360ms; }
        .reveal-group.is-visible > *:nth-child(6) { transition-delay: 450ms; }
      }

      @media (max-width: 880px) {
        .hero, .consult { grid-template-columns: 1fr; }
        .trust-strip { grid-template-columns: 1fr; }
        .faq-list { grid-template-columns: 1fr; }
        .hero-art { order: -1; max-width: 24rem; margin: 0 auto 1.5rem; }
        .ribbon-links { justify-content: center; width: 100%; }

        .nav-toggle { display: flex; }
        .main-nav {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: flex-start;
          gap: 1.1rem;
          background: var(--card);
          border-bottom: 1px solid var(--line);
          padding: 1.5rem clamp(1.25rem, 5vw, 4rem) 2rem;
          box-shadow: 0 16px 30px -20px rgba(18, 59, 94, 0.35);
        }
        .main-nav.is-open { display: flex; }
        .main-nav .nav-cta { width: 100%; text-align: center; }

        body { padding-bottom: 4.75rem; }
        .sticky-cta { display: block; }
      }
    </style>

    <script>
      const navToggle = document.querySelector('.nav-toggle');
      const mainNav = document.querySelector('.main-nav');
      if (navToggle && mainNav) {
        navToggle.addEventListener('click', () => {
          const isOpen = mainNav.classList.toggle('is-open');
          navToggle.classList.toggle('is-open', isOpen);
          navToggle.setAttribute('aria-expanded', String(isOpen));
          navToggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
        });
        mainNav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            mainNav.classList.remove('is-open');
            navToggle.classList.remove('is-open');
            navToggle.setAttribute('aria-expanded', 'false');
            navToggle.setAttribute('aria-label', 'Open menu');
          });
        });
      }

      // Real hours: Mon–Thu 9–6:30, Fri 9–12, closed Sat/Sun.
      const weekHours = [
        null,
        { open: 9 * 60, close: 18 * 60 + 30 },
        { open: 9 * 60, close: 18 * 60 + 30 },
        { open: 9 * 60, close: 17 * 60 },
        { open: 9 * 60, close: 18 * 60 + 30 },
        { open: 9 * 60, close: 12 * 60 },
        null,
      ];
      function formatClock(mins) {
        let h = Math.floor(mins / 60);
        const m = mins % 60;
        const ampm = h >= 12 ? 'pm' : 'am';
        h = h % 12 || 12;
        return m === 0 ? `${h}${ampm}` : `${h}:${String(m).padStart(2, '0')}${ampm}`;
      }
      const hoursBadge = document.getElementById('hours-badge');
      if (hoursBadge) {
        const now = new Date();
        const today = weekHours[now.getDay()];
        const minutesNow = now.getHours() * 60 + now.getMinutes();
        if (today && minutesNow >= today.open && minutesNow < today.close) {
          hoursBadge.innerHTML = `<span class="dot dot-open"></span> Open now &middot; closes ${formatClock(today.close)}`;
        } else {
          hoursBadge.innerHTML = `<span class="dot dot-closed"></span> Closed now &middot; call to schedule`;
        }
      }

      // Gentle fade/slide-in on load and scroll. Classes are added here, not in the markup,
      // so content stays fully visible if JS never runs. Respects prefers-reduced-motion.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const singleSelectors = '.hero-copy, .hero-art, .trust-strip, .consult-copy, .consult-form';
        const groupSelectors = '.services-grid, .team-grid, .testimonial-grid, .process-grid, .faq-list';

        document.querySelectorAll(singleSelectors).forEach((el) => el.classList.add('reveal'));
        document.querySelectorAll(groupSelectors).forEach((el) => el.classList.add('reveal-group'));

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );

        document.querySelectorAll('.reveal, .reveal-group').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
