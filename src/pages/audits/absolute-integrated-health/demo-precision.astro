---
export const prerender = false;

const services = [
  {
    name: 'Chiropractic Care',
    line: 'Hands-on adjustment and mobility work for the pain that’s been slowing you down.',
  },
  {
    name: 'Pain Management',
    line: 'A plan built around your body, not a prescription pad — for pain that hasn’t responded to anything else.',
  },
  {
    name: 'IV & Hormone Therapy',
    line: 'Targeted support for energy, recovery, and balance, administered in-office by our clinical team.',
  },
  {
    name: 'Wound Care',
    line: 'Specialized treatment for wounds that need more attention than a standard visit provides.',
  },
  {
    name: 'Aesthetics & Wellness',
    line: 'Skin, body, and confidence — treatments designed around how you actually want to feel.',
  },
];

const team = [
  { name: 'Dr. James Nakis', role: 'Chiropractor', credential: 'DC', photo: '/audits/absolute-integrated-health/staff-jim.jpg' },
  { name: 'Alyssa Fleischauer', role: 'RN', credential: 'RN', photo: '/audits/absolute-integrated-health/staff-alyssa.jpg' },
  { name: 'Cynthia Clark-Zurawski', role: 'FNP, APRN', credential: 'FNP, APRN', photo: '/audits/absolute-integrated-health/staff-cynthia.webp' },
  { name: 'Andrew Nakis', role: 'Care Team', credential: null, photo: '/audits/absolute-integrated-health/staff-andrew.jpg' },
  { name: 'Monica Galik', role: 'Care Team', credential: null, photo: '/audits/absolute-integrated-health/staff-monica.webp' },
  { name: 'Jay Zurawski', role: 'RN', credential: 'RN', photo: '/audits/absolute-integrated-health/staff-jay.jpg' },
];

const credentialBadges = [
  'Licensed Chiropractic Care (DC)',
  'RN & APRN-Led Clinical Team',
  '15 Credentialed Providers',
  '4.8★ · 235 Google Reviews',
];

const intakeOptions = [
  'Chronic or ongoing pain',
  'IV or hormone therapy',
  'Aesthetics & wellness',
  'Wound care',
  'Not sure yet — I’d like to talk it through',
];

const timePreferences = ['Weekday mornings', 'Weekday afternoons', 'Weekday evenings', 'Weekends'];

const serviceCategories = [
  {
    name: 'Pain & Mobility',
    line: 'Chiropractic care, chronic and acute pain, physical therapy, and spinal decompression.',
    items: ['Chiropractic Care', 'Chronic Pain', 'Knee Pain', 'Neuropathy Treatment', 'Physical Therapy', 'Spinal Decompression'],
  },
  {
    name: 'IV & Wellness Therapy',
    line: 'IV nutrient therapy, IVIG, hormone therapy, and allergen testing, administered in-office.',
    items: ['IV Therapy', 'IVIG', 'Hormone Therapy', 'Allergen Testing'],
  },
  {
    name: 'Vein & Wound Care',
    line: 'Specialized treatment for venous conditions and wounds that need more than a standard visit.',
    items: ['Vein Care', 'Wound Care'],
  },
  {
    name: 'Aesthetics & Medspa',
    line: 'Injectables, facials, laser treatments, and skin care from a clinical team you already trust.',
    items: ['Injectables', 'Facials & Peels', 'Lasers & Microneedling', 'Skin Care'],
  },
];

const processSteps = [
  {
    title: 'Consultation',
    body: 'Tell us what’s going on and what you’re hoping to fix — no assumptions, just a real conversation.',
  },
  {
    title: 'Assessment',
    body: 'Our team examines you in person and builds a plan around your body, not a generic protocol.',
  },
  {
    title: 'Personalized Plan',
    body: 'Start treatment the same day when appropriate, with follow-ups scheduled around your life.',
  },
];

const faqs = [
  {
    q: 'Do you accept insurance?',
    a: 'We work with most major insurance plans, and offer 0% APR financing for services that aren’t covered.',
  },
  {
    q: 'What should I bring to my first visit?',
    a: 'Just a photo ID and your insurance card, if you have one — we’ll handle the rest during your consultation.',
  },
  {
    q: 'Do I need a referral?',
    a: 'No referral is required for a chiropractic or wellness consultation.',
  },
  {
    q: 'Can I walk in, or do I need an appointment?',
    a: 'We recommend requesting a consultation ahead of time so we can prepare for your visit — call 815-782-8440 for same-day availability.',
  },
