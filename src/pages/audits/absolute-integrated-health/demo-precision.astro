        </div>
        <a href="#team">Our Team</a>
        <a href="#faq">FAQ</a>
      </nav>
      <div class="nav-actions">
        <a href="tel:8157828440" class="btn btn-ghost btn-nav">815-782-8440</a>
        <a href="#request-consultation" class="btn btn-primary btn-nav">Request a Consultation</a>
      </div>
      <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-photo" role="img" aria-label="A patient and a member of our clinical team sharing a reassuring moment during a visit">
          <img src="/audits/absolute-integrated-health/hero-precision.jpg" alt="" />
        </div>
        <div class="hero-inner">
          <p class="eyebrow">Plainfield, IL · Chiropractic &amp; Integrative Health</p>
          <h1>Care that starts with a conversation, not a form.</h1>
          <p class="hero-sub">
            Chiropractic, pain management, IV therapy, and aesthetics under one roof — one path
