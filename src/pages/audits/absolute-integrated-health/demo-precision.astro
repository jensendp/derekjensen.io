const testimonials = [
  {
    quote: 'Friendly greeting, caring staff, to professional workforce. Your experience and well being is paramount in here. You’ll be leaving with a healed body and a smile on your face. I will recommend to family and friends.',
    name: 'Arnulfo Q.',
  },
  {
    quote: 'Not just another chiropractor. They treat the whole body. Trusted innovative procedures. Friendly helpful staff. Give ’em a try. I’ve been seeing them for 20+ years.',
