          </p>
          <div class="hero-actions">
            <a href="#request-consultation" class="btn btn-primary btn-lg">Request a Consultation</a>
            <a href="tel:8157828440" class="btn btn-ghost btn-lg btn-ghost-on-dark">815-782-8440</a>
          </div>
          <p class="hours-badge" id="hours-badge"></p>
        </div>
      </section>

      <section class="credential-strip" aria-label="Practice credentials">
        {credentialBadges.map((c) => (
          <span class="pill-tag">
            <svg class="pill-tag-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8.5L6.2 11.7L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {c}
          </span>
        ))}
      </section>

      <section id="services" class="categories">
        <p class="section-eyebrow">What we treat</p>
        <h2>One practice, four ways in</h2>
        <p class="section-sub">Every path starts the same way — a consultation, not a booking form.</p>
        <div class="category-grid">
          {serviceCategories.map((cat) => (
            <div class="category-card">
              <h3>{cat.name}</h3>
              <p class="category-line">{cat.line}</p>
              <ul class="category-items">
