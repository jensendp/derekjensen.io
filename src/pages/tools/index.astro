---
import BaseLayout from '@layouts/BaseLayout.astro';

const tools = [
  {
    href: '/tools/prompt-builder',
    icon: '🛠️',
    title: 'AI Prompt Builder',
    description: 'Describe your idea, answer 3 questions, and get a complete AI build starter kit — project brief, tech stack, ready-to-paste prompts, and a build plan tailored to your project.',
  },
  {
    href: '/tools/ai-visibility-check',
    icon: '🤖',
    title: 'AI Visibility Check',
    description: "Find out whether ChatGPT, Perplexity, and Gemini can actually find and recommend your business — a scored audit of your Google listing, website, and AI crawler access.",
  },
];
---

<BaseLayout
  title="Free Tools"
  description="Free tools from Derek Jensen — an AI build starter kit generator and an AI search visibility checker for local businesses."
>
  <section class="py-16 sm:py-24">
    <div class="animate-in">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-600 mb-4">Free Tools</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-neutral-900 tracking-tight mb-6">
        Tools I've built, free to use.
      </h1>
      <p class="text-xl text-neutral-600 max-w-2xl leading-relaxed">
        No signup walls, no upsell tricks — just tools that solve a real problem, built the same
        way I build everything else.
      </p>
    </div>
  </section>

  <section class="pb-16 sm:pb-24">
    <div class="grid sm:grid-cols-2 gap-6">
      {tools.map((tool, i) => (
        <a href={tool.href} class={`card p-6 hover-lift block group animate-in delay-${Math.min(i + 1, 4)}`}>
          <div class="text-3xl mb-4">{tool.icon}</div>
          <h2 class="text-lg font-semibold text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors">
            {tool.title}
          </h2>
          <p class="text-sm text-neutral-600 leading-relaxed mb-4">{tool.description}</p>
          <span class="text-sm font-medium text-primary-600 inline-flex items-center gap-1">
            Try it
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
