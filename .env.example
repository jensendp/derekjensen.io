# Contact Form Webhook
# Replace with your webhook URL
PUBLIC_CONTACT_WEBHOOK_URL=
PUBLIC_TRAINING_WAITLIST_WEBHOOK_URL=

# Anthropic API — from console.anthropic.com
ANTHROPIC_API_KEY=

# Brevo — from brevo.com → Settings → API Keys
BREVO_API_KEY=
# A verified sender email in your Brevo account
BREVO_SENDER_EMAIL=
# Optional: Brevo list ID to organize newsletter subscribers (Settings → Contacts → Lists)
BREVO_LIST_ID=

# Upstash Redis (REST API) — used for rate limiting on the API routes. Free-tier databases are
# reclaimed after ~14 days of inactivity; see /api/keepalive + vercel.json's weekly cron.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Places API (Places API (Legacy) — plain Cloud API key, no OAuth/approval needed)
# Used by /tools/ai-visibility-check to look up a business's Google listing
GOOGLE_PLACES_API_KEY=

# Secures /api/keepalive so only Vercel's own Cron trigger can call it — Vercel automatically
# sends this as "Authorization: Bearer <value>" when invoking a scheduled job.
CRON_SECRET=
